# .env.example

# --- Core Infrastructure ---
# Redis connection string for Celery and streaming
REDIS_URL=redis://redis:6379/0

# PostgreSQL connection string
# The default user/pass is 'postgres'/'postgres' as set in docker-compose.yml
POSTGRES_URL=postgresql://postgres:postgres@db:5432/multi_agent

# --- Security ---
# A secret key for signing various things.
# You can generate one with: openssl rand -hex 32
SECRET_KEY=

# --- LLM Provider ---
# Your Google AI API Key for Gemini models
GOOGLE_API_KEY=

# --- Read-only DB User (for SQL tool safety) ---
# These should match the credentials you want to create for the read-only role.
# The migration in 002_add_readonly_role.py will use these to create the user.
POSTGRES_READONLY_USER=mega_readonly
POSTGRES_READONLY_PASSWORD=

